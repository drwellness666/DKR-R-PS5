function(dkrr_stage_native_session)
    get_target_property(_sources librecomp SOURCES)
    get_target_property(_directory librecomp SOURCE_DIR)
    set(_inputs)
    foreach(_source IN LISTS _sources)
        if(_source MATCHES "/(recomp|overlays)\\.cpp$")
            if(NOT IS_ABSOLUTE "${_source}")
                get_filename_component(_source "${_source}" ABSOLUTE BASE_DIR "${_directory}")
            endif()
            list(APPEND _inputs "${_source}")
        endif()
    endforeach()
    list(LENGTH _inputs _count)
    if(NOT _count EQUAL 2)
        message(FATAL_ERROR "Unexpected stopped-runtime source graph")
    endif()
    set(_stage "${CMAKE_BINARY_DIR}/native-session")
    execute_process(COMMAND "${Python3_EXECUTABLE}" -B
        "${DKR_PS5_ADAPTERS_ROOT}/../tools/stage_ps5_session.py"
        "${_stage}" ${_inputs} RESULT_VARIABLE _result)
    if(NOT _result EQUAL 0)
        message(FATAL_ERROR "Native session composition failed")
    endif()
    file(READ "${_stage}/RECEIPT.json" _swaps)
    foreach(_index RANGE 0 1)
        string(JSON _old GET "${_swaps}" ${_index} old)
        string(JSON _new GET "${_swaps}" ${_index} new)
        dkrr_release_source_properties("${_old}" "${_new}" librecomp)
        list(TRANSFORM _sources REPLACE "^${_old}$" "${_new}")
    endforeach()
    set_property(TARGET librecomp PROPERTY SOURCES "${_sources}")
    target_include_directories(DKRPortGame PRIVATE "${DKR_PS5_ADAPTERS_ROOT}")
endfunction()
# The final source domain and all guest cancellation layers must run first.
cmake_language(DEFER CALL dkrr_stage_native_session)
