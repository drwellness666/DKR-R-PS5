function(dkrr_native_process_policy)
    get_target_property(_sources DKRPortGame SOURCES)
    set(_count 0)
    foreach(_source IN LISTS _sources)
        if(_source MATCHES "/sdl3_input_client\\.cpp$")
            set(_replacement "${DKR_PS5_ADAPTERS_ROOT}/ps5_builtin_input.cpp")
            dkrr_release_source_properties("${_source}" "${_replacement}" DKRPortGame)
            list(TRANSFORM _sources REPLACE "^${_source}$" "${_replacement}")
            math(EXPR _count "${_count}+1")
        endif()
    endforeach()
    if(NOT _count EQUAL 1)
        message(FATAL_ERROR "Unexpected native input ownership graph")
    endif()
    set_property(TARGET DKRPortGame PROPERTY SOURCES "${_sources}")
    get_target_property(_sources LiveRecomp SOURCES)
    set(_count 0)
    foreach(_source IN LISTS _sources)
        if(_source MATCHES "/sljitLir\\.c$")
            set(_stage "${CMAKE_BINARY_DIR}/native-exec")
            execute_process(COMMAND "${Python3_EXECUTABLE}" -B
                "${DKR_PS5_ADAPTERS_ROOT}/../tools/stage_ps5_sljit.py"
                "${_source}" "${_stage}" RESULT_VARIABLE _result)
            if(NOT _result EQUAL 0)
                message(FATAL_ERROR "Native SLJIT executable allocator preparation failed")
            endif()
            set(_replacement "${_stage}/sljitLir.c")
            dkrr_release_source_properties("${_source}" "${_replacement}" LiveRecomp)
            list(TRANSFORM _sources REPLACE "^${_source}$" "${_replacement}")
            math(EXPR _count "${_count}+1")
        endif()
    endforeach()
    if(NOT _count EQUAL 1)
        message(FATAL_ERROR "Unexpected native mod-code allocator graph")
    endif()
    set_property(TARGET LiveRecomp PROPERTY SOURCES "${_sources}")
    target_include_directories(LiveRecomp PRIVATE "${DKR_PS5_ADAPTERS_ROOT}")
endfunction()
cmake_language(DEFER CALL dkrr_native_process_policy)
