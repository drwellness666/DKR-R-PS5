# Compose the official post-capsule layers against their original source inputs.
set(DKR_PS5_COMPOSED_CAPSULE ON)
set(DKR_SDK2_REUSE_STAGE "${DKRPORT_ROOT}/runtime-recomp/ps5-release/roles/SDK2")
set(DKR_MOD_STORE_STAGE "${DKRPORT_ROOT}/runtime-recomp/ps5-release/roles/MOD_STORE")
function(dkrr_release_source_properties old next target)
    get_target_property(directory ${target} SOURCE_DIR)
    foreach(property INCLUDE_DIRECTORIES COMPILE_OPTIONS COMPILE_DEFINITIONS)
        get_property(defined SOURCE "${old}" DIRECTORY "${directory}" PROPERTY ${property} SET)
        if(defined)
            get_property(value SOURCE "${old}" DIRECTORY "${directory}" PROPERTY ${property})
            set_property(SOURCE "${next}" DIRECTORY "${directory}" PROPERTY ${property} "${value}")
        endif()
    endforeach()
    get_filename_component(prior "${old}" DIRECTORY)
    set_property(SOURCE "${next}" DIRECTORY "${directory}" APPEND PROPERTY INCLUDE_DIRECTORIES "${prior}")
endfunction()
get_property(_native_targets DIRECTORY "${CMAKE_CURRENT_SOURCE_DIR}" PROPERTY BUILDSYSTEM_TARGETS)
foreach(_target IN LISTS _native_targets)
    get_target_property(_sources ${_target} SOURCES)
    if(NOT _sources OR _sources MATCHES "-NOTFOUND$")
        continue()
    endif()
    get_target_property(_source_dir ${_target} SOURCE_DIR)
    set(_next_sources)
    foreach(_source IN LISTS _sources)
        set(_original "${_source}")
        if(NOT IS_ABSOLUTE "${_source}" AND NOT _source MATCHES "^\\$<")
            get_filename_component(_source "${_source}" ABSOLUTE BASE_DIR "${_source_dir}")
        endif()
        set(_next "${_source}")
        if(IS_ABSOLUTE "${_source}" AND _source MATCHES "^${DKRPORT_ROOT}/runtime-recomp/(src|include|tests)/")
            file(RELATIVE_PATH _relative "${DKRPORT_ROOT}/runtime-recomp" "${_source}")
            set(_next "${DKRPORT_ROOT}/runtime-recomp/ps5-release/native-base/${_relative}")
            if(NOT EXISTS "${_next}")
                message(FATAL_ERROR "Missing immutable pre-platform release source: ${_relative}")
            endif()
            if(_target STREQUAL "DKRNetplayCore")
                set(_cached "${DKRPORT_ROOT}/runtime-recomp/ps5-release/roles/SDK2_BASE/native/${_relative}")
                if(EXISTS "${_cached}")
                    file(SHA256 "${_next}" _one)
                    file(SHA256 "${_cached}" _two)
                    if(_one STREQUAL _two)
                        set(_next "${_cached}")
                    endif()
                endif()
            endif()
            dkrr_release_source_properties("${_original}" "${_next}" ${_target})
        endif()
        list(APPEND _next_sources "${_next}")
    endforeach()
    set_property(TARGET ${_target} PROPERTY SOURCES "${_next_sources}")
endforeach()
include("${DKRPORT_ROOT}/patches/release-prep/v1.0.9/ReleaseOverlay.cmake")
function(dkrr_capture_release109)
    set(_json "[")
    set(_sep "")
    get_property(_targets DIRECTORY "${CMAKE_CURRENT_SOURCE_DIR}" PROPERTY BUILDSYSTEM_TARGETS)
    list(APPEND _targets rt64)
    foreach(_target IN LISTS _targets)
        get_target_property(_type ${_target} TYPE)
        if(_type STREQUAL "INTERFACE_LIBRARY")
            continue()
        endif()
        get_target_property(_paths ${_target} SOURCES)
        get_target_property(_dir ${_target} SOURCE_DIR)
        if(NOT _paths OR _paths MATCHES "-NOTFOUND$")
            continue()
        endif()
        foreach(_path IN LISTS _paths)
            if(_path MATCHES "^\\$<")
                continue()
            endif()
            if(NOT IS_ABSOLUTE "${_path}")
                get_filename_component(_path "${_path}" ABSOLUTE BASE_DIR "${_dir}")
            endif()
            get_property(_has_includes SOURCE "${_path}" DIRECTORY "${_dir}" PROPERTY INCLUDE_DIRECTORIES SET)
            if(_has_includes)
                get_property(_includes SOURCE "${_path}" DIRECTORY "${_dir}" PROPERTY INCLUDE_DIRECTORIES)
                set(_absolute)
                foreach(_include IN LISTS _includes)
                    if(NOT IS_ABSOLUTE "${_include}" AND NOT _include MATCHES "^\\$<")
                        get_filename_component(_include "${_include}" ABSOLUTE BASE_DIR "${_dir}")
                    endif()
                    list(APPEND _absolute "${_include}")
                endforeach()
                set_property(SOURCE "${_path}" DIRECTORY "${_dir}" PROPERTY INCLUDE_DIRECTORIES "${_absolute}")
            endif()
            file(TO_CMAKE_PATH "${_path}" _path)
            string(APPEND _json "${_sep}{\"target\":\"${_target}\",\"path\":\"${_path}\"}")
            set(_sep ",")
        endforeach()
    endforeach()
    string(APPEND _json "]\n")
    file(WRITE "${CMAKE_BINARY_DIR}/ps5-release-graph.json" "${_json}")
endfunction()
cmake_language(DEFER CALL dkrr_capture_release109)
function(dkrr_apply_final_platform109)
    set(_stage "${CMAKE_BINARY_DIR}/generated/ps5-final")
    execute_process(COMMAND "${Python3_EXECUTABLE}" -B "${DKR_PS5_ADAPTERS_ROOT}/../tools/stage_ps5_release_final.py"
        --source "${DKRPORT_ROOT}" --build "${CMAKE_BINARY_DIR}" --output "${_stage}" RESULT_VARIABLE _result)
    if(NOT _result EQUAL 0)
        message(FATAL_ERROR "Final 1.0.9 PS5 source adaptations differ from reviewed inputs")
    endif()
    file(READ "${_stage}/swaps.json" _swaps)
    string(JSON _count LENGTH "${_swaps}")
    math(EXPR _last "${_count}-1")
    get_property(_targets DIRECTORY "${CMAKE_CURRENT_SOURCE_DIR}" PROPERTY BUILDSYSTEM_TARGETS)
    list(APPEND _targets rt64)
    foreach(_target IN LISTS _targets)
        get_target_property(_sources ${_target} SOURCES)
        if(NOT _sources OR _sources MATCHES "-NOTFOUND$")
            continue()
        endif()
        foreach(_index RANGE ${_last})
            string(JSON _old GET "${_swaps}" ${_index} old)
            string(JSON _new GET "${_swaps}" ${_index} new)
            list(FIND _sources "${_old}" _found)
            if(NOT _found EQUAL -1)
                dkrr_release_source_properties("${_old}" "${_new}" ${_target})
                list(TRANSFORM _sources REPLACE "^${_old}$" "${_new}")
            endif()
        endforeach()
        set_property(TARGET ${_target} PROPERTY SOURCES "${_sources}")
    endforeach()
    set(_importer "${CMAKE_BINARY_DIR}/generated/ps5-embedded-importer")
    execute_process(COMMAND "${Python3_EXECUTABLE}" -B "${DKR_PS5_ADAPTERS_ROOT}/../tools/stage_embedded_importer.py"
        --source "${DKRPORT_ROOT}" --output "${_importer}" RESULT_VARIABLE _result)
    if(NOT _result EQUAL 0)
        message(FATAL_ERROR "Native data import dispatcher input changed")
    endif()
    target_sources(DKRLegacyModProcess PRIVATE "${_importer}/embedded_importer.cpp")
    target_include_directories(DKRLegacyModProcess PRIVATE "${DKR_PS5_ADAPTERS_ROOT}"
        "${DKRPORT_ROOT}/runtime-recomp/src/game/mods" "${DKR_RT64_SOURCE}/src/contrib")
    target_include_directories(DKRLegacyModCore PRIVATE "${DKR_PS5_ADAPTERS_ROOT}")
    target_link_libraries(DKRLegacyModProcess PUBLIC DKRLegacyWorkerCore DKROnlineModPreparation)
    foreach(_target DKRPortGame DKRNetplayCore)
        target_compile_definitions(${_target} PRIVATE DKRR_STATIC_HTTPS=1)
        target_include_directories(${_target} PRIVATE "${DKR_PS5_ADAPTERS_ROOT}")
    endforeach()
    set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS
        "${DKR_PS5_ADAPTERS_ROOT}/../tools/stage_ps5_release_final.py"
        "${DKR_PS5_ADAPTERS_ROOT}/../patches/dkrr-109-native-final.patch"
        "${DKR_PS5_ADAPTERS_ROOT}/../patches/dkrr-109-final-manifest.json")
endfunction()
cmake_language(DEFER CALL dkrr_apply_final_platform109)
function(dkrr_native_domain_targets directory output)
    get_property(_items DIRECTORY "${directory}" PROPERTY BUILDSYSTEM_TARGETS)
    get_property(_children DIRECTORY "${directory}" PROPERTY SUBDIRECTORIES)
    foreach(_child IN LISTS _children)
        dkrr_native_domain_targets("${_child}" _nested)
        list(APPEND _items ${_nested})
    endforeach()
    set(${output} "${_items}" PARENT_SCOPE)
endfunction()
function(dkrr_apply_native_domain109)
    execute_process(COMMAND "${Python3_EXECUTABLE}" -B "${DKR_PS5_ADAPTERS_ROOT}/../tools/canonicalize_native_domain.py"
        --source "${DKRPORT_ROOT}" --build "${CMAKE_BINARY_DIR}" RESULT_VARIABLE _result)
    if(NOT _result EQUAL 0)
        message(FATAL_ERROR "The native source/header domain could not be reconstructed")
    endif()
    include("${CMAKE_BINARY_DIR}/native-domain/paths.cmake")
    dkrr_native_domain_targets("${CMAKE_CURRENT_SOURCE_DIR}" _targets)
    foreach(_target IN LISTS _targets)
        get_target_property(_dir ${_target} SOURCE_DIR)
        foreach(_property SOURCES INTERFACE_SOURCES INCLUDE_DIRECTORIES INTERFACE_INCLUDE_DIRECTORIES)
            get_target_property(_values ${_target} ${_property})
            if(NOT _values OR _values MATCHES "-NOTFOUND$")
                continue()
            endif()
            set(_next_values)
            foreach(_value IN LISTS _values)
                dkrr_native_domain_path("${_value}" _next)
                if(_property STREQUAL "SOURCES" AND NOT _next STREQUAL _value)
                    dkrr_release_source_properties("${_value}" "${_next}" ${_target})
                    get_property(_includes SOURCE "${_next}" DIRECTORY "${_dir}" PROPERTY INCLUDE_DIRECTORIES)
                    set(_new_includes)
                    foreach(_include IN LISTS _includes)
                        dkrr_native_domain_path("${_include}" _mapped)
                        list(APPEND _new_includes "${_mapped}")
                    endforeach()
                    set_property(SOURCE "${_next}" DIRECTORY "${_dir}" PROPERTY INCLUDE_DIRECTORIES "${_new_includes}")
                endif()
                list(APPEND _next_values "${_next}")
            endforeach()
            set_property(TARGET ${_target} PROPERTY ${_property} "${_next_values}")
        endforeach()
    endforeach()
endfunction()
cmake_language(DEFER CALL dkrr_apply_native_domain109)
