+        // L2 used to fire items. Move Z to L1, and retain the N64 L action
+        // on Triangle so no original action is dropped or fired with braking.
+        result[index(Action::Z)].controller = SDL_CONTROLLER_BUTTON_LEFTSHOULDER;
+        result[index(Action::L)].controller = SDL_CONTROLLER_BUTTON_Y;
+        // R2 already drives N64 A above in both presentation profiles. Avoid
+        // a second host-only action overriding the original release behavior.
+        result[index(Action::Accelerate)].controller = dkr::runtime::input::kUnbound;
+    }
