+bool dkr::runtime::input::migrate_removed_ps5_driving_layout(std::size_t player) {
+#if DKR_RUNTIME_HAS_RT64
+    if (player >= kPlayerCount) return false;
+    // Compatibility only: this layout is no longer selectable. Match every
+    // controller slot, including empty alternates; preserve any custom edit,
+    // all keyboard bindings, shortcuts and the other players.
+    PlayerBindings legacy = kDefaults;
+    const auto index = [](Action action) { return static_cast<std::size_t>(action); };
+    legacy[index(Action::A)].controller_secondary =
+        kAxisSourceBase + SDL_CONTROLLER_AXIS_TRIGGERRIGHT * 2 + 1;
+    legacy[index(Action::B)].controller_secondary =
+        kAxisSourceBase + SDL_CONTROLLER_AXIS_TRIGGERLEFT * 2 + 1;
+    legacy[index(Action::Z)].controller = SDL_CONTROLLER_BUTTON_LEFTSHOULDER;
+    legacy[index(Action::L)].controller = SDL_CONTROLLER_BUTTON_Y;
+    legacy[index(Action::Accelerate)].controller = kUnbound;
+    std::scoped_lock lock(g_binding_mutex);
+    for (std::size_t slot = 0; slot < legacy.size(); ++slot) {
+        if (g_bindings[player][slot].controller != legacy[slot].controller ||
+            g_bindings[player][slot].controller_secondary != legacy[slot].controller_secondary)
+            return false;
+    }
+    for (std::size_t slot = 0; slot < legacy.size(); ++slot) {
+        g_bindings[player][slot].controller = kDefaults[slot].controller;
