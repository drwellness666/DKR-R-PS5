+        g.word(a::GameMode)==0&&!g.byte(a::IsPaused)&&!g.word(a::IsInTracksMenu)&&!g.word(a::LevelLoadTimer);
+}
+std::uint32_t NativeSoundObject(const dkrr::ps5_lights::Guest&g,unsigned port) {
+    namespace a=dkr::runtime::revision_addresses;
+    if(port>=4||!g.valid(a::NumberOfRacers,4)||!g.valid(a::RacersByPort,4))return 0;
+    const auto count=g.word(a::NumberOfRacers),table=g.word(a::RacersByPort);
+    if(!count||count>10||port>=count||(table&3U)||!g.valid(table,count*4U))return 0;
+    const auto object=g.word(table+port*4U);
+    if((object&3U)||!g.valid(object,0x68))return 0;const auto racer=g.word(object+0x64);
+    if((racer&3U)||!g.valid(racer,2)||(unsigned(g.byte(racer))<<8|g.byte(racer+1))!=port)return 0;
+    return object;
+}
