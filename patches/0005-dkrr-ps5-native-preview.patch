+extern "C" void dkrr_controller_game_sound(const std::uint8_t* ram,unsigned port,unsigned clip) {
+    if(clip>=dkrr::ps5_sounds::count||!NativeSoundContext(ram))return;
+    const dkrr::ps5_lights::Guest g({ram,0x800000});
+    if(NativeSoundObject(g,port)){
+        g_controller_sounds.publish(port,clip,ControllerLightTime());
+    }
+}
+extern "C" void dkrr_controller_zipper_sound(const std::uint8_t*ram,std::uint32_t x,std::uint32_t y,std::uint32_t z) {
+    if(!NativeSoundContext(ram))return;const dkrr::ps5_lights::Guest g({ram,0x800000});
+    for(unsigned port=0;port<4;++port){const auto object=NativeSoundObject(g,port);
+        if(object&&g.word(object+0xc)==x&&g.word(object+0x10)==y&&g.word(object+0x14)==z)
+            dkrr_controller_game_sound(ram,port,dkrr::ps5_sounds::zipper);
+    }
+}
