+bool StartDialogJob(std::function<std::function<void()>()> job);
+// The native picker is part of this ImGui frame. Its storage work belongs on
+// the dialog thread; only the selected action and UI state run on the UI thread.
+bool ChooseFileForAction(const nfdfilteritem_t* filters, nfdfiltersize_t count,
+    const char* filename, std::string& status,
+    std::function<bool(const std::filesystem::path&)> action) {
+    std::vector<std::pair<std::string,std::string>> copied;
+    for (nfdfiltersize_t i=0;i<count;++i) copied.emplace_back(filters[i].name,filters[i].spec);
+    const std::string name=filename?filename:"";
+    auto pick=[copied=std::move(copied),name]() {
+        std::pair<std::filesystem::path,std::string> answer;
+        if (NFD_Init()!=NFD_OKAY) {
+            answer.second="The file picker could not be initialized.";return answer;
+        }
+        std::vector<nfdfilteritem_t> items;
+        for (const auto& item:copied) items.push_back({item.first.c_str(),item.second.c_str()});
+        nfdu8char_t* result=nullptr;
+        const auto code=name.empty()?NFD_OpenDialogU8(&result,items.data(),static_cast<nfdfiltersize_t>(items.size()),nullptr):
+            NFD_SaveDialogU8(&result,items.data(),static_cast<nfdfiltersize_t>(items.size()),nullptr,name.c_str());
+        if (code==NFD_OKAY) { answer.first=std::filesystem::path(reinterpret_cast<const char8_t*>(result));NFD_FreePathU8(result); }
+        else if (code==NFD_ERROR) answer.second=NFD_GetError();
+        NFD_Quit();return answer;
+    };
+#if defined(__PROSPERO__)
+    const bool started=StartDialogJob([pick=std::move(pick),action=std::move(action),status=&status]() -> std::function<void()> {
+        auto [path,error]=pick();
+        return [path=std::move(path),error=std::move(error),action,status] {
+            if (!error.empty()) *status=error;
+            else if (!path.empty()) action(path);
+        };
+    });
+    if (!started) status="The file picker could not start. Wait for other file operations to finish and try again.";
+    return started;
+#else
+    const auto [path,error]=pick();
+    if (!error.empty()) status=error;
+    return !path.empty() && action(path);
+#endif
+}
