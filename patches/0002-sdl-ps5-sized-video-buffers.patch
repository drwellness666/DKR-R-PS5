 {
-    return SDL_Unsupported();
+    static const char reset[] = "DKRR-RESET-LIGHTBAR-1";
+    PS5_PadContext *ctx = PS5_JoystickGetPadContext(joystick);
+    int err;
+    if (!ctx) return SDL_SetError("PS5_JoystickSendEffect: instance not connected");
+    if (data && size == (int)sizeof(reset) && !SDL_memcmp(data, reset, sizeof(reset))) {
+        err = scePadResetLightBar(ctx->handle);
+        return err ? SDL_SetError("scePadResetLightBar: 0x%08x", err) : 0;
+    }
+    if (!data || size != (int)sizeof(PS5_ItemEffect))
+        return SDL_Unsupported();
+    PS5_ItemEffect effect;
+    SDL_memcpy(&effect, data, sizeof(effect));
+    if (effect.magic != 0x44545247 || effect.mode > 2 || effect.strength > 5 ||
+        effect.reserved[0] || effect.reserved[1]) return SDL_Unsupported();
+    PS5_TriggerParameters native;
+    SDL_zero(native);
+    native.mask = 1; /* L2 only. Do not change R2's owner or behavior. */
+    if (effect.mode == 1 && effect.strength) {
+        native.command[0].mode = 2; /* weapon resistance */
+        native.command[0].data[0] = 3;
+        native.command[0].data[1] = 6;
+        native.command[0].data[2] = effect.strength;
+    } else if (effect.mode == 2 && effect.strength) {
+        native.command[0].mode = 3; /* brief motor-arm vibration */
+        native.command[0].data[0] = 0; /* impulse remains perceptible on release */
+        native.command[0].data[1] = effect.strength;
+        native.command[0].data[2] = 50;
+    }
+    err = scePadSetTriggerEffect(ctx->handle, &native);
+    return err ? SDL_SetError("scePadSetTriggerEffect: 0x%08x", err) : 0;
 }
 
