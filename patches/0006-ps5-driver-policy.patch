+/* Configuring HDMI is asynchronous. Sample a bounded number of windows before
+ * deciding that a successfully accepted high-refresh mode stayed at 60 Hz.
+ * Failed waits still fall back immediately; the 12.5 ms validity gate remains.
+ * This runs only during output initialization, never in the present loop. */
+static uint64_t
+videoout_high_refresh_period_ns(int handle)
+{
+   uint64_t period = videoout_vblank_period_ns(handle);
+   for (unsigned attempt = 1; period > VIDEOOUT_HIGH_REFRESH_LIMIT_NS && attempt < 4; attempt++)
+      period = videoout_vblank_period_ns(handle);
+   return period;
+}
